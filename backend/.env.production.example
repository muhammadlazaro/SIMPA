# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# API Base URL - Update this to your production backend URL
VITE_API_BASE_URL=https://your-production-domain.com/api

# Application Name
VITE_APP_NAME="Aplikasi Management System"

# Enable/Disable Debug Mode (set to false in production)
VITE_DEBUG=false

# API Timeout (in milliseconds)
VITE_API_TIMEOUT=30000
